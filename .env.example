# ==============================================================================
# WellWise AI — Complete Environment Configuration Template (.env.example)
# Copy this file to .env and provide your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Exposed to browser via Vite - VITE_ prefix required)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous Publishable Key (SAFE to be exposed in browser with RLS)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key

# Optional: Direct Supabase Edge Function URL (if invoking Supabase Edge Function directly)
# Leave empty to use local secure proxy /api/chat
VITE_SUPABASE_FUNCTION_URL=

# ------------------------------------------------------------------------------
# BACKEND SERVER CONFIGURATION (Private Secrets — NEVER prefix with VITE_)
# ------------------------------------------------------------------------------
# Port for the local Express server (default: 5000)
PORT=5000

# Primary AI Provider: Google Gemini API Key (recommended, free tier available)
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Secondary AI Provider / Fallback: OpenAI API Key
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# WHATSAPP BUSINESS CLOUD API (Optional — for automated server reminders)
# ------------------------------------------------------------------------------
# Cloud API Phone Number ID from Meta Developer Portal
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# System User Permanent Access Token for Meta Graph API
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token

# Custom webhook verification token configured in Meta App Dashboard
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token

# ------------------------------------------------------------------------------
# MAPS & LOCATION SERVICES
# ------------------------------------------------------------------------------
# WellWise AI uses Leaflet + OpenStreetMap and Overpass API out of the box.
# No proprietary Maps API key is required. Attribution is preserved in the UI.
